# Shared secret every service checks on X-DBOps-Service-Token. Change it.
DBOPS_SERVICE_TOKEN=change-me
# Mock only: 1.0 = realistic delays, 0 = everything instant.
MOCK_TIME_SCALE=1.0

# ---- Part 2: agent-api (placeholders only; put real values in .env, never commit them) ----
# LLM for the chat agent, as a LiteLLM model string <provider>/<model> (https://docs.litellm.ai/docs/providers).
# Chat messages and tool results are sent to this provider. Examples: deepseek/deepseek-chat,
# anthropic/claude-sonnet-5-5, openai/gpt-5, bedrock/<model-id> (uses AWS_PROFILE; that principal then also
# needs bedrock:InvokeModel).
LLM_MODEL=deepseek/deepseek-chat
# The provider's own key variable is read automatically; set only the one you use.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Optional overrides: a key for any provider, and a custom endpoint (e.g. a LiteLLM proxy or self-hosted model).
# LLM_API_KEY=
# LLM_API_BASE=
# AWS profile in ~/.aws (mounted read-only into agent-api). Use a dedicated read-only principal.
AWS_PROFILE=dbops-readonly
# self-hosted (default, verified) runs awslabs.aws-api-mcp-server; managed uses the AWS MCP Server via mcp-proxy-for-aws-cli.
AWS_MCP_MODE=self-hosted
AWS_MCP_ENDPOINT=https://aws-mcp.us-east-1.api.aws/mcp
# Only databases carrying this tag are visible to the agent.
DBOPS_SCOPE_TAG_KEY=dbops:demo
DBOPS_SCOPE_TAG_VALUE=true
# Comma-separated.
DBOPS_AWS_REGIONS=us-east-1
